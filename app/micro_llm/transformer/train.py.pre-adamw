"""Train GNOME Micro Transformer using pure NumPy."""

import argparse
from pathlib import Path

import numpy as np

from app.micro_llm.transformer.model import (
    TransformerLanguageModel,
)


def load_training_bytes(path: Path) -> np.ndarray:
    """Load every text file beneath the training directory."""

    chunks = []

    for file in sorted(path.rglob("*.txt")):
        data = file.read_bytes()

        if data:
            chunks.append(data)

    if not chunks:
        raise RuntimeError(
            f"No training text found in {path}"
        )

    corpus = b"\n".join(chunks)

    return np.frombuffer(
        corpus,
        dtype=np.uint8,
    ).astype(np.int64)


def parameters(model):
    """Map gradient names to actual model parameters."""

    result = {
        "lm_head": model.lm_head,
        "lm_bias": model.lm_bias,
        "embeddings.token": model.embeddings.token,
        "embeddings.position": model.embeddings.position,
    }

    for index, block in enumerate(model.blocks):
        prefix = f"blocks.{index}"

        result.update({
            f"{prefix}.wq": block.attention.wq,
            f"{prefix}.wk": block.attention.wk,
            f"{prefix}.wv": block.attention.wv,
            f"{prefix}.wo": block.attention.wo,

            f"{prefix}.w1": block.w1,
            f"{prefix}.b1": block.b1,
            f"{prefix}.w2": block.w2,
            f"{prefix}.b2": block.b2,

            f"{prefix}.ln1_gamma":
                block.ln1_gamma,

            f"{prefix}.ln1_beta":
                block.ln1_beta,

            f"{prefix}.ln2_gamma":
                block.ln2_gamma,

            f"{prefix}.ln2_beta":
                block.ln2_beta,
        })

    return result


def sample_batch(
    lessons: list[np.ndarray],
    context: int,
    batch_size: int,
    rng: np.random.Generator,
):
    """Build lesson batches with strong answer supervision."""

    x_batch = []
    y_batch = []
    weight_batch = []

    indexes = rng.integers(
        0,
        len(lessons),
        size=batch_size,
    )

    separator = b"\n\n"
    answer_marker = b"ANSWER:"

    needed = context + 1

    for index in indexes:
        lesson_bytes = bytes(
            lessons[int(index)].astype(np.uint8)
        )

        # Fill the context with meaningful lessons rather
        # than hundreds of padding newlines.
        stream = bytearray()

        while len(stream) < needed:
            stream.extend(lesson_bytes)
            stream.extend(separator)

        stream = bytes(stream[:needed])

        sequence = np.frombuffer(
            stream,
            dtype=np.uint8,
        ).astype(np.int64)

        x = sequence[:context]
        y = sequence[1:needed]

        # Base supervision keeps GNOME literate.
        weights = np.full(
            context,
            0.10,
            dtype=np.float64,
        )

        # Strongly supervise bytes belonging to answers.
        search_from = 0

        while True:
            marker = stream.find(
                answer_marker,
                search_from,
            )

            if marker == -1:
                break

            answer_start = marker + len(answer_marker)

            # Skip the space after "ANSWER:".
            while (
                answer_start < len(stream)
                and stream[answer_start:answer_start + 1]
                in (b" ", b"\t")
            ):
                answer_start += 1

            answer_end = stream.find(
                b"\n",
                answer_start,
            )

            if answer_end == -1:
                answer_end = len(stream)

            # y[position] predicts stream[position + 1].
            target_start = max(
                0,
                answer_start - 1,
            )

            target_end = min(
                context,
                answer_end,
            )

            weights[
                target_start:target_end
            ] = 1.0

            search_from = max(
                answer_end + 1,
                marker + 1,
            )

        x_batch.append(x)
        y_batch.append(y)
        weight_batch.append(weights)

    return (
        np.stack(x_batch),
        np.stack(y_batch),
        np.stack(weight_batch),
    )



def clip_gradients(
    gradients,
    maximum_norm: float,
):
    """Global gradient-norm clipping."""

    total_squared = 0.0

    for gradient in gradients.values():
        total_squared += float(
            np.sum(gradient * gradient)
        )

    norm = np.sqrt(total_squared)

    if norm > maximum_norm:
        scale = maximum_norm / (
            norm + 1e-8
        )

        for gradient in gradients.values():
            gradient *= scale

    return float(norm)


def save_model(
    model,
    path: Path,
):
    """Save every trainable parameter."""

    state = parameters(model)

    path.parent.mkdir(
        parents=True,
        exist_ok=True,
    )

    np.savez(
        path,
        **state,
    )


def main():
    parser = argparse.ArgumentParser()

    parser.add_argument(
        "--data",
        default="data/training",
    )

    parser.add_argument(
        "--steps",
        type=int,
        default=1000,
    )

    parser.add_argument(
        "--batch-size",
        type=int,
        default=8,
    )

    parser.add_argument(
        "--learning-rate",
        type=float,
        default=0.01,
    )

    parser.add_argument(
        "--clip",
        type=float,
        default=1.0,
    )

    parser.add_argument(
        "--output",
        default="models/gnome-transformer-v04.npz",
    )

    args = parser.parse_args()

    model = TransformerLanguageModel()

    rng = np.random.default_rng(2026)

    lessons = load_training_lessons(
        Path(args.data)
    )

    params = parameters(model)

    print("GNOME Micro v0.4 — TRANSFORMER")
    print("--------------------------------")
    print(
        "Training bytes:",
        f"{sum(len(x) for x in lessons):,}",
    )
    print(
        "Parameters:",
        f"{model.parameter_count:,}",
    )
    print(
        "Context:",
        model.config.context_size,
    )
    print(
        "Batch size:",
        args.batch_size,
    )
    print(
        "Steps:",
        args.steps,
    )
    print(
        "Learning rate:",
        args.learning_rate,
    )
    print()

    running_loss = None

    for step in range(
        1,
        args.steps + 1,
    ):
        x, y, weights = sample_batch(
            lessons,
            model.config.context_size,
            args.batch_size,
            rng,
        )

        loss, cache = model.forward_loss(
            x,
            y,
            weights=weights,
        )

        gradients = model.backward(
            cache
        )

        grad_norm = clip_gradients(
            gradients,
            args.clip,
        )

        for name, parameter in params.items():
            parameter -= (
                args.learning_rate
                * gradients[name]
            )

        if running_loss is None:
            running_loss = loss
        else:
            running_loss = (
                0.95 * running_loss
                + 0.05 * loss
            )

        if (
            step == 1
            or step % 25 == 0
            or step == args.steps
        ):
            print(
                f"Step {step:05d} | "
                f"loss {loss:.4f} | "
                f"avg {running_loss:.4f} | "
                f"grad {grad_norm:.4f}"
            )

        if not np.isfinite(loss):
            raise RuntimeError(
                "Training diverged: "
                "loss became non-finite."
            )

    output = Path(args.output)

    save_model(
        model,
        output,
    )

    print()
    print(
        "Saved:",
        output,
    )


def load_training_lessons(
    path: Path,
) -> list[np.ndarray]:
    """Load QUESTION/EVIDENCE/ANSWER lessons separately."""

    lessons = []

    for file in sorted(path.rglob("*.txt")):
        text = file.read_text(
            encoding="utf-8",
        )

        for raw in text.split("\n\n"):
            raw = raw.strip()

            if not raw:
                continue

            data = raw.encode("utf-8")

            lessons.append(
                np.frombuffer(
                    data,
                    dtype=np.uint8,
                ).astype(np.int64)
            )

    if not lessons:
        raise RuntimeError(
            f"No training lessons found in {path}"
        )

    return lessons

if __name__ == "__main__":
    main()
