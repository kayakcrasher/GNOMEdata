"""Train GNOME Micro Transformer using pure NumPy."""

import argparse
from pathlib import Path

import numpy as np

from app.micro_llm.transformer.model import (
    TransformerLanguageModel,
)


def load_training_bytes(path: Path) -> np.ndarray:
    """Load every text file beneath the training directory."""

    chunks = []

    for file in sorted(path.rglob("*.txt")):
        data = file.read_bytes()

        if data:
            chunks.append(data)

    if not chunks:
        raise RuntimeError(
            f"No training text found in {path}"
        )

    corpus = b"\n".join(chunks)

    return np.frombuffer(
        corpus,
        dtype=np.uint8,
    ).astype(np.int64)


def parameters(model):
    """Map gradient names to actual model parameters."""

    result = {
        "lm_head": model.lm_head,
        "lm_bias": model.lm_bias,
        "embeddings.token": model.embeddings.token,
        "embeddings.position": model.embeddings.position,
    }

    for index, block in enumerate(model.blocks):
        prefix = f"blocks.{index}"

        result.update({
            f"{prefix}.wq": block.attention.wq,
            f"{prefix}.wk": block.attention.wk,
            f"{prefix}.wv": block.attention.wv,
            f"{prefix}.wo": block.attention.wo,

            f"{prefix}.w1": block.w1,
            f"{prefix}.b1": block.b1,
            f"{prefix}.w2": block.w2,
            f"{prefix}.b2": block.b2,

            f"{prefix}.ln1_gamma":
                block.ln1_gamma,

            f"{prefix}.ln1_beta":
                block.ln1_beta,

            f"{prefix}.ln2_gamma":
                block.ln2_gamma,

            f"{prefix}.ln2_beta":
                block.ln2_beta,
        })

    return result


def sample_batch(
    lessons: list[np.ndarray],
    context: int,
    batch_size: int,
    rng: np.random.Generator,
):
    """Build lesson batches with strong answer supervision."""

    x_batch = []
    y_batch = []
    weight_batch = []

    indexes = rng.integers(
        0,
        len(lessons),
        size=batch_size,
    )

    separator = b"\n\n"
    answer_marker = b"ANSWER:"

    needed = context + 1

    for index in indexes:
        lesson_bytes = bytes(
            lessons[int(index)].astype(np.uint8)
        )

        # Fill the context with meaningful lessons rather
        # than hundreds of padding newlines.
        stream = bytearray()

        while len(stream) < needed:
            stream.extend(lesson_bytes)
            stream.extend(separator)

        stream = bytes(stream[:needed])

        sequence = np.frombuffer(
            stream,
            dtype=np.uint8,
        ).astype(np.int64)

        x = sequence[:context]
        y = sequence[1:needed]

        # Base supervision keeps GNOME literate.
        weights = np.full(
            context,
            0.10,
            dtype=np.float64,
        )

        # Strongly supervise bytes belonging to answers.
        search_from = 0

        while True:
            marker = stream.find(
                answer_marker,
                search_from,
            )

            if marker == -1:
                break

            answer_start = marker + len(answer_marker)

            # Skip the space after "ANSWER:".
            while (
                answer_start < len(stream)
                and stream[answer_start:answer_start + 1]
                in (b" ", b"\t")
            ):
                answer_start += 1

            answer_end = stream.find(
                b"\n",
                answer_start,
            )

            if answer_end == -1:
                answer_end = len(stream)

            # y[position] predicts stream[position + 1].
            target_start = max(
                0,
                answer_start - 1,
            )

            target_end = min(
                context,
                answer_end,
            )

            weights[
                target_start:target_end
            ] = 1.0

            search_from = max(
                answer_end + 1,
                marker + 1,
            )

        x_batch.append(x)
        y_batch.append(y)
        weight_batch.append(weights)

    return (
        np.stack(x_batch),
        np.stack(y_batch),
        np.stack(weight_batch),
    )




class AdamW:
    """Small pure-NumPy AdamW optimizer."""

    def __init__(
        self,
        params,
        learning_rate=0.001,
        beta1=0.9,
        beta2=0.999,
        epsilon=1e-8,
        weight_decay=0.01,
    ):
        self.params = params
        self.learning_rate = learning_rate
        self.beta1 = beta1
        self.beta2 = beta2
        self.epsilon = epsilon
        self.weight_decay = weight_decay

        self.step_number = 0

        self.m = {
            name: np.zeros_like(value)
            for name, value in params.items()
        }

        self.v = {
            name: np.zeros_like(value)
            for name, value in params.items()
        }

    def step(
        self,
        gradients,
        learning_rate=None,
    ):
        self.step_number += 1

        lr = (
            self.learning_rate
            if learning_rate is None
            else learning_rate
        )

        correction1 = (
            1.0 - self.beta1 ** self.step_number
        )

        correction2 = (
            1.0 - self.beta2 ** self.step_number
        )

        for name, parameter in self.params.items():
            gradient = gradients[name]

            self.m[name] = (
                self.beta1 * self.m[name]
                + (1.0 - self.beta1) * gradient
            )

            self.v[name] = (
                self.beta2 * self.v[name]
                + (1.0 - self.beta2)
                * (gradient * gradient)
            )

            m_hat = self.m[name] / correction1
            v_hat = self.v[name] / correction2

            # Decoupled weight decay.
            parameter *= (
                1.0 - lr * self.weight_decay
            )

            parameter -= (
                lr
                * m_hat
                / (np.sqrt(v_hat) + self.epsilon)
            )


def scheduled_learning_rate(
    step: int,
    total_steps: int,
    peak_lr: float,
    warmup_steps: int,
    minimum_ratio: float = 0.10,
) -> float:
    """Linear warmup followed by cosine decay."""

    if warmup_steps > 0 and step <= warmup_steps:
        return peak_lr * (
            step / warmup_steps
        )

    decay_steps = max(
        1,
        total_steps - warmup_steps,
    )

    progress = (
        step - warmup_steps
    ) / decay_steps

    progress = min(
        1.0,
        max(0.0, progress),
    )

    cosine = 0.5 * (
        1.0 + np.cos(np.pi * progress)
    )

    minimum_lr = (
        peak_lr * minimum_ratio
    )

    return (
        minimum_lr
        + (peak_lr - minimum_lr) * cosine
    )



def split_lessons(
    lessons: list[np.ndarray],
    validation_ratio: float = 0.10,
    seed: int = 2026,
):
    """Create deterministic train/validation splits."""

    if not 0.0 < validation_ratio < 1.0:
        raise ValueError(
            "validation_ratio must be between 0 and 1."
        )

    if len(lessons) < 2:
        raise ValueError(
            "Need at least two lessons."
        )

    rng = np.random.default_rng(seed)

    indexes = rng.permutation(len(lessons))

    validation_size = max(
        1,
        int(round(
            len(lessons) * validation_ratio
        )),
    )

    validation_indexes = indexes[:validation_size]
    train_indexes = indexes[validation_size:]

    train = [
        lessons[int(index)]
        for index in train_indexes
    ]

    validation = [
        lessons[int(index)]
        for index in validation_indexes
    ]

    return train, validation


def evaluate_model(
    model,
    lessons: list[np.ndarray],
    batch_size: int,
    rng: np.random.Generator,
    batches: int = 4,
) -> float:
    """Estimate weighted loss on held-out lessons."""

    losses = []

    for _ in range(batches):
        x, y, weights = sample_batch(
            lessons,
            model.config.context_size,
            batch_size,
            rng,
        )

        loss, _ = model.forward_loss(
            x,
            y,
            weights=weights,
        )

        losses.append(loss)

    return float(np.mean(losses))


class EarlyStopping:
    """Track validation improvement and patience."""

    def __init__(
        self,
        patience: int = 5,
        minimum_delta: float = 1e-4,
    ):
        self.patience = patience
        self.minimum_delta = minimum_delta

        self.best_loss = float("inf")
        self.best_step = 0
        self.bad_checks = 0

    def update(
        self,
        loss: float,
        step: int,
    ) -> tuple[bool, bool]:
        """Return (improved, should_stop)."""

        improved = (
            loss
            < self.best_loss - self.minimum_delta
        )

        if improved:
            self.best_loss = loss
            self.best_step = step
            self.bad_checks = 0
        else:
            self.bad_checks += 1

        should_stop = (
            self.bad_checks >= self.patience
        )

        return improved, should_stop


def clip_gradients(
    gradients,
    maximum_norm: float,
):
    """Global gradient-norm clipping."""

    total_squared = 0.0

    for gradient in gradients.values():
        total_squared += float(
            np.sum(gradient * gradient)
        )

    norm = np.sqrt(total_squared)

    if norm > maximum_norm:
        scale = maximum_norm / (
            norm + 1e-8
        )

        for gradient in gradients.values():
            gradient *= scale

    return float(norm)


def save_model(
    model,
    path: Path,
):
    """Save every trainable parameter."""

    state = parameters(model)

    path.parent.mkdir(
        parents=True,
        exist_ok=True,
    )

    np.savez(
        path,
        **state,
    )


def main():
    parser = argparse.ArgumentParser()

    parser.add_argument(
        "--data",
        default="data/training",
    )

    parser.add_argument(
        "--steps",
        type=int,
        default=1000,
    )

    parser.add_argument(
        "--batch-size",
        type=int,
        default=8,
    )

    parser.add_argument(
        "--learning-rate",
        type=float,
        default=0.001,
    )

    parser.add_argument(
        "--clip",
        type=float,
        default=1.0,
    )

    parser.add_argument(
        "--warmup-steps",
        type=int,
        default=100,
    )

    parser.add_argument(
        "--weight-decay",
        type=float,
        default=0.01,
    )

    parser.add_argument(
        "--min-lr-ratio",
        type=float,
        default=0.10,
    )

    parser.add_argument(
        "--validation-ratio",
        type=float,
        default=0.10,
    )

    parser.add_argument(
        "--validate-every",
        type=int,
        default=100,
    )

    parser.add_argument(
        "--validation-batches",
        type=int,
        default=4,
    )

    parser.add_argument(
        "--patience",
        type=int,
        default=8,
    )

    parser.add_argument(
        "--output",
        default="models/gnome-transformer-v04.npz",
    )

    args = parser.parse_args()

    model = TransformerLanguageModel()

    rng = np.random.default_rng(2026)

    lessons = load_training_lessons(
        Path(args.data)
    )

    train_lessons, validation_lessons = split_lessons(
        lessons,
        validation_ratio=args.validation_ratio,
        seed=2026,
    )

    validation_rng = np.random.default_rng(90210)

    early_stopping = EarlyStopping(
        patience=args.patience,
    )

    best_output = Path(args.output).with_name(
        Path(args.output).stem + "-best.npz"
    )

    params = parameters(model)

    optimizer = AdamW(
        params,
        learning_rate=args.learning_rate,
        weight_decay=args.weight_decay,
    )

    print("GNOME Micro v0.4 — TRANSFORMER")
    print("--------------------------------")
    print(
        "Training bytes:",
        f"{sum(len(x) for x in lessons):,}",
    )
    print(
        "Parameters:",
        f"{model.parameter_count:,}",
    )
    print(
        "Context:",
        model.config.context_size,
    )
    print(
        "Batch size:",
        args.batch_size,
    )
    print(
        "Steps:",
        args.steps,
    )
    print(
        "Learning rate:",
        args.learning_rate,
    )
    print()

    running_loss = None

    for step in range(
        1,
        args.steps + 1,
    ):
        x, y, weights = sample_batch(
            train_lessons,
            model.config.context_size,
            args.batch_size,
            rng,
        )

        loss, cache = model.forward_loss(
            x,
            y,
            weights=weights,
        )

        gradients = model.backward(
            cache
        )

        grad_norm = clip_gradients(
            gradients,
            args.clip,
        )

        learning_rate = scheduled_learning_rate(
            step=step,
            total_steps=args.steps,
            peak_lr=args.learning_rate,
            warmup_steps=args.warmup_steps,
            minimum_ratio=args.min_lr_ratio,
        )

        optimizer.step(
            gradients,
            learning_rate=learning_rate,
        )

        if running_loss is None:
            running_loss = loss
        else:
            running_loss = (
                0.95 * running_loss
                + 0.05 * loss
            )

        if (
            step == 1
            or step % 25 == 0
            or step == args.steps
        ):
            print(
                f"Step {step:05d} | "
                f"loss {loss:.4f} | "
                f"avg {running_loss:.4f} | "
                f"grad {grad_norm:.4f}"
            )

        if not np.isfinite(loss):
            raise RuntimeError(
                "Training diverged: "
                "loss became non-finite."
            )

        if (
            step % args.validate_every == 0
            or step == args.steps
        ):
            validation_loss = evaluate_model(
                model,
                validation_lessons,
                batch_size=args.batch_size,
                rng=validation_rng,
                batches=args.validation_batches,
            )

            improved, should_stop = (
                early_stopping.update(
                    validation_loss,
                    step,
                )
            )

            status = (
                "★ BEST"
                if improved
                else
                f"patience "
                f"{early_stopping.bad_checks}/"
                f"{early_stopping.patience}"
            )

            print(
                f"VALIDATION | "
                f"step {step:05d} | "
                f"loss {validation_loss:.4f} | "
                f"{status}"
            )

            if improved:
                save_model(
                    model,
                    best_output,
                )

            if should_stop:
                print()
                print(
                    "EARLY STOP | "
                    f"best validation "
                    f"{early_stopping.best_loss:.4f} "
                    f"at step "
                    f"{early_stopping.best_step}"
                )
                break

    output = Path(args.output)

    save_model(
        model,
        output,
    )

    print()
    print(
        "Saved:",
        output,
    )


def load_training_lessons(
    path: Path,
) -> list[np.ndarray]:
    """Load QUESTION/EVIDENCE/ANSWER lessons separately."""

    lessons = []

    for file in sorted(path.rglob("*.txt")):
        text = file.read_text(
            encoding="utf-8",
        )

        for raw in text.split("\n\n"):
            raw = raw.strip()

            if not raw:
                continue

            data = raw.encode("utf-8")

            lessons.append(
                np.frombuffer(
                    data,
                    dtype=np.uint8,
                ).astype(np.int64)
            )

    if not lessons:
        raise RuntimeError(
            f"No training lessons found in {path}"
        )

    return lessons

if __name__ == "__main__":
    main()
